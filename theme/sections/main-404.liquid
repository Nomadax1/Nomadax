<section class="notfound section" {{ section.shopify_attributes }}>
  <div class="container notfound__inner" data-reveal-group>
    <p class="eyebrow eyebrow--accent reveal-mask"><span>404</span></p>
    <h1 class="display-xl"><span class="reveal-mask" style="--reveal-delay:100ms"><span>{{ section.settings.title | default: '404.title' | t }}</span></span></h1>
    <p class="lead" data-reveal style="--reveal-delay:220ms">{{ section.settings.subtitle | default: '404.subtitle' | t }}</p>
    <a class="btn" href="{{ section.settings.link | default: routes.all_products_collection_url }}" data-reveal style="--reveal-delay:340ms">{{ section.settings.cta | default: '404.cta' | t }}</a>
  </div>
</section>
<style>
  .notfound { min-height: 60vh; display: flex; align-items: center; }
  .notfound__inner { display: flex; flex-direction: column; gap: var(--space-5); align-items: flex-start; }
  .notfound .display-xl { text-transform: uppercase; max-width: 8em; }
</style>

{% schema %}
{
  "name": "404",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "cta", "label": "Button text" },
    { "type": "url", "id": "link", "label": "Button link" }
  ]
}
{% endschema %}
