{{ 'home.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="panels section--flush" data-panels {{ section.shopify_attributes }}>
  {%- if s.title != blank or s.eyebrow != blank -%}
    <div class="container panels__head" data-reveal>
      {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.title != blank -%}<h2 class="display-m">{{ s.title }}</h2>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="panels__row">
    {%- for block in section.blocks -%}
      {%- liquid
        assign collection = block.settings.collection
        assign title = block.settings.title | default: collection.title | default: 'Category'
        assign image = block.settings.image | default: collection.featured_image
        assign url = block.settings.link | default: collection.url | default: routes.all_products_collection_url
      -%}
      <a class="panel{% if forloop.first %} is-active{% endif %}" href="{{ url }}" data-panel data-cursor="{{ 'general.discover' | t }}" data-cursor-theme="inverse" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <div class="panel__media">
          {% render 'image', image: image, sizes: '(min-width: 990px) 45vw, 80vw', placeholder: forloop.index, placeholder_label: title %}
        </div>
        <span class="panel__index eyebrow eyebrow--bare">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <span class="panel__title-vertical vertical-text">{{ title }}</span>
        <span class="panel__content">
          <span class="panel__title display-m">{{ title }}</span>
          {%- if block.settings.subtitle != blank -%}<span class="panel__subtitle">{{ block.settings.subtitle }}</span>{%- endif -%}
          <span class="link link--lined panel__cta">{%- assign td_6 = 'general.shop_now' | t -%}{{ block.settings.cta | default: td_6 }}</span>
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category panels",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Discover by" },
    { "type": "text", "id": "title", "label": "Title", "default": "Category" },
    { "type": "paragraph", "content": "Desktop: interactive panels that expand on hover. Mobile: swipeable editorial cards." }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "The pieces that start the outfit" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "cta", "label": "Link text", "default": "Discover" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [
    {
      "name": "Category panels",
      "blocks": [
        { "type": "panel", "settings": { "title": "New in", "subtitle": "Just landed, in limited numbers" } },
        { "type": "panel", "settings": { "title": "Dresses", "subtitle": "Satin, jersey and sculpted crepe" } },
        { "type": "panel", "settings": { "title": "Tops", "subtitle": "The pieces that start the outfit" } },
        { "type": "panel", "settings": { "title": "Bottoms", "subtitle": "Tailored, wide, fluid" } },
        { "type": "panel", "settings": { "title": "Sets", "subtitle": "Two pieces, one decision" } },
        { "type": "panel", "settings": { "title": "Essentials", "subtitle": "Worn on repeat" } }
      ]
    }
  ]
}
{% endschema %}
