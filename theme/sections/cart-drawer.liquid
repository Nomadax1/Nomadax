{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign progress = 0
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  endif
-%}
<cart-drawer id="CartDrawer" class="drawer drawer--right" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1" data-section-id="{{ section.id }}">
  <div data-cart-content>
    <div class="drawer__head">
      <h2 class="drawer__title" id="CartDrawerTitle">{{ 'cart.title' | t }} <span class="text-sm muted">({{ cart.item_count }})</span></h2>
      <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>

    <div class="drawer__body">
      {%- if cart.item_count == 0 -%}
        <div class="cart-drawer__empty">
          <p class="display-s">{{ 'cart.empty' | t }}</p>
          <a class="btn btn--outline" href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" data-drawer-close>{{ 'cart.empty_cta' | t }}</a>
        </div>
      {%- else -%}
        {%- if threshold > 0 -%}
          <div class="shipping-bar{% if remaining <= 0 %} shipping-bar--unlocked{% endif %}" data-shipping-bar>
            <p class="shipping-bar__text">
              {%- if remaining > 0 -%}
                {%- assign remaining_money = remaining | money -%}{{ 'cart.free_shipping_progress' | t: amount: remaining_money }}
              {%- else -%}
                {{ 'cart.free_shipping_unlocked' | t }}
              {%- endif -%}
            </p>
            <div class="shipping-bar__track"><div class="shipping-bar__fill" style="width: {{ progress }}%"></div></div>
          </div>
        {%- endif -%}

        <div class="cart-items" data-cart-items>
          {%- for item in cart.items -%}
            <div class="cart-item" data-cart-item data-line="{{ forloop.index }}" data-key="{{ item.key }}">
              <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                <div class="media">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 300 | image_tag: widths: '150, 300', sizes: '88px', loading: 'lazy', alt: item.title }}
                  {%- else -%}
                    {% render 'placeholder', variant: forloop.index, label: item.product.title %}
                  {%- endif -%}
                </div>
              </a>
              <div class="cart-item__body">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <span class="cart-item__meta">
                    {%- for option in item.options_with_values -%}
                      {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
                    {%- endfor -%}
                  </span>
                {%- endunless -%}
                {%- if item.selling_plan_allocation -%}
                  <span class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                {%- endif -%}
                <span class="cart-item__price">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s>{{ item.original_line_price | money }}</s>{{ item.final_line_price | money }}
                  {%- else -%}
                    {{ item.final_line_price | money }}
                  {%- endif -%}
                </span>
                {%- if item.line_level_discount_allocations.size > 0 -%}
                  <span class="cart-item__discounts">
                    {%- for d in item.line_level_discount_allocations -%}{{ d.discount_application.title }} (−{{ d.amount | money }}){% unless forloop.last %}, {% endunless %}{%- endfor -%}
                  </span>
                {%- endif -%}
                <div class="cart-item__row">
                  <div class="qty" data-qty>
                    <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'products.product.decrease' | t }}">−</button>
                    <input class="qty__input" type="number" inputmode="numeric" min="0" value="{{ item.quantity }}" aria-label="{{ 'cart.quantity' | t }}" data-qty-input data-line="{{ forloop.index }}">
                    <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'products.product.increase' | t }}">+</button>
                  </div>
                  <button type="button" class="cart-item__remove" data-cart-remove data-line="{{ forloop.index }}">{{ 'cart.remove' | t }}</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if settings.cart_recommendations and section.settings.recommendation_collection != blank -%}
          {%- liquid
            assign cart_handles = ''
            for item in cart.items
              assign cart_handles = cart_handles | append: item.product.handle | append: ','
            endfor
            assign recs_shown = 0
          -%}
          <div class="cart-drawer__recs">
            <p class="eyebrow eyebrow--muted cart-drawer__recs-title">{{ 'cart.you_may_also_like' | t }}</p>
            <div class="cart-recs">
              {%- for product in section.settings.recommendation_collection.products limit: 12 -%}
                {%- assign handle_key = product.handle | append: ',' -%}
                {%- unless cart_handles contains handle_key or recs_shown >= 3 or product.available == false -%}
                  {%- assign recs_shown = recs_shown | plus: 1 -%}
                  <div class="cart-rec">
                    <a href="{{ product.url }}" class="media" tabindex="-1">
                      {%- if product.featured_media -%}
                        {{ product.featured_media | image_url: width: 300 | image_tag: widths: '150, 300', sizes: '120px', loading: 'lazy', alt: product.title }}
                      {%- else -%}
                        {% render 'placeholder', variant: forloop.index, label: product.title %}
                      {%- endif -%}
                    </a>
                    <a href="{{ product.url }}" class="cart-rec__title">{{ product.title }}</a>
                    <span class="cart-rec__price">{% render 'price', product: product, show_from: true %}</span>
                    {%- if product.variants.size == 1 -%}
                      <button type="button" class="cart-rec__add" data-quick-add-variant="{{ product.selected_or_first_available_variant.id }}">{{ 'products.product.add_to_bag' | t }}</button>
                    {%- else -%}
                      <a class="cart-rec__add" href="{{ product.url }}">{{ 'products.product.select_size' | t }}</a>
                    {%- endif -%}
                  </div>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__foot">
        {%- if settings.cart_notes -%}
          <details class="cart-note">
            <summary class="link">{{ 'cart.note' | t }}</summary>
            <textarea name="note" data-cart-note placeholder="{{ 'cart.note_placeholder' | t }}" aria-label="{{ 'cart.note' | t }}">{{ cart.note }}</textarea>
          </details>
        {%- endif -%}
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          {%- for d in cart.cart_level_discount_applications -%}
            <div class="cart-summary__row text-sm"><span>{{ d.title }}</span><span>−{{ d.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
        {%- endif -%}
        <div class="cart-summary__row cart-summary__row--total">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span data-cart-subtotal>{{ cart.total_price | money_with_currency }}</span>
        </div>
        <p class="cart-summary__note">{{ 'cart.taxes_shipping' | t }}</p>
        <div class="cart-summary__actions">
          <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm">
            <button type="submit" name="checkout" class="btn btn--block">{{ 'cart.checkout' | t }}</button>
          </form>
          <button type="button" class="link" data-drawer-close>{{ 'cart.continue_shopping' | t }}</button>
        </div>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "collection", "id": "recommendation_collection", "label": "\"You may also like\" collection", "info": "Pieces already in the bag are skipped. Up to 3 shown." },
    { "type": "url", "id": "empty_link", "label": "Empty bag CTA link" }
  ]
}
{% endschema %}
