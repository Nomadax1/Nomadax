<div class="password__inner" style="max-width:40rem;text-align:center;display:flex;flex-direction:column;align-items:center;gap:var(--space-5)">
  <span class="wordmark">{{ settings.brand_name | default: shop.name }}</span>
  <h1 class="display-l">{{ section.settings.title }}</h1>
  {%- if shop.password_message != blank -%}<p class="lead" style="opacity:.8">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'access__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, private-access">
    {%- if form.posted_successfully? -%}<p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>{%- else -%}
      <div class="access__field" style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center">
        <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.label' | t }}</label>
        <input id="PasswordEmail" class="field__input" style="max-width:18rem;border-bottom-color:rgba(255,255,255,.4)" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" required>
        <button type="submit" class="btn btn--inverse">{{ 'newsletter.submit' | t }}</button>
      </div>
    {%- endif -%}
  {%- endform -%}
  <details style="margin-top:2rem">
    <summary class="link">{{ section.settings.password_label }}</summary>
    {%- form 'storefront_password', style: 'margin-top:1rem;display:flex;gap:1rem;justify-content:center;flex-wrap:wrap' -%}
      {%- if form.errors -%}<p class="form-error" style="width:100%">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="visually-hidden" for="Password">Password</label>
      <input id="Password" class="field__input" style="max-width:14rem;border-bottom-color:rgba(255,255,255,.4)" type="password" name="password" placeholder="Password">
      <button type="submit" class="btn btn--ghost">Enter</button>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Opening soon" },
    { "type": "text", "id": "password_label", "label": "Password link text", "default": "Enter with password" }
  ]
}
{% endschema %}
