{{ 'collection.css' | asset_url | stylesheet_tag }}
<section class="coll-list section--tight" {{ section.shopify_attributes }}>
  <div class="container">
    <header class="page-head" data-reveal-group>
      <p class="eyebrow eyebrow--accent reveal-mask"><span>{{ settings.season_label }}</span></p>
      <h1 class="display-xl page-head__title"><span class="reveal-mask" style="--reveal-delay:100ms"><span>{%- assign td_7 = 'collections.general.all_collections' | t -%}{{ section.settings.title | default: td_7 }}</span></span></h1>
    </header>
    <div class="coll-list__grid">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a class="coll-list__item" href="{{ collection.url }}" data-reveal data-cursor="{{ 'general.discover' | t }}" style="--reveal-delay: {{ forloop.index0 | modulo: 3 | times: 80 }}ms">
            <div class="media media--hover media--tall">
              {% render 'image', image: collection.image, sizes: '(min-width: 990px) 33vw, 100vw', placeholder: forloop.index, placeholder_label: collection.title %}
            </div>
            <span class="coll-list__meta">
              <span class="coll-list__title display-s">{{ collection.title }}</span>
              <span class="text-sm muted">{{ collection.all_products_count }} {{ 'collections.general.pieces' | t }}</span>
            </span>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Collections" }
  ]
}
{% endschema %}
