[
  {
    "name": "theme_info",
    "theme_name": "Solenne Editorial",
    "theme_version": "1.0.0",
    "theme_author": "Nomadax Studio",
    "theme_documentation_url": "https://github.com/Nomadax1/Nomadax/tree/main/theme",
    "theme_support_url": "https://github.com/Nomadax1/Nomadax/issues"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "text", "id": "brand_name", "label": "Brand name (wordmark)", "default": "SOLENNE", "info": "Used as the text wordmark when no logo is uploaded, and in the footer statement." },
      { "type": "image_picker", "id": "logo", "label": "Logo (optional)" },
      { "type": "image_picker", "id": "logo_inverse", "label": "Logo on dark / over hero (optional)" },
      { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 260, "step": 10, "unit": "px", "default": 120 },
      { "type": "text", "id": "brand_tagline", "label": "Tagline", "default": "Contemporary womenswear, worn your way." },
      { "type": "text", "id": "season_label", "label": "Season label", "default": "Autumn / Winter 26", "info": "Shown in vertical side text, mega menu and collection headers." }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_bg", "label": "Background (ivory)", "default": "#F5F1EA" },
      { "type": "color", "id": "color_bg_2", "label": "Secondary surface (sand)", "default": "#EAE3D6" },
      { "type": "color", "id": "color_ink", "label": "Text (ink)", "default": "#141311" },
      { "type": "color", "id": "color_ink_2", "label": "Muted text", "default": "#6F6A62" },
      { "type": "color", "id": "color_line", "label": "Lines", "default": "#D8D1C5" },
      { "type": "color", "id": "color_accent", "label": "Accent", "default": "#B23A2E" },
      { "type": "color", "id": "color_on_accent", "label": "Text on accent", "default": "#FBF7F1" },
      { "type": "color", "id": "color_inverse_bg", "label": "Dark surface", "default": "#151412" },
      { "type": "color", "id": "color_inverse_ink", "label": "Text on dark surface", "default": "#F5F1EA" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "font_display", "label": "Display font (headlines)", "default": "instrument_serif_n4" },
      { "type": "font_picker", "id": "font_body", "label": "Interface font", "default": "instrument_sans_n4" },
      { "type": "range", "id": "display_scale", "label": "Display scale", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100 },
      { "type": "range", "id": "body_scale", "label": "Body scale", "min": 90, "max": 115, "step": 5, "unit": "%", "default": 100 },
      { "type": "checkbox", "id": "uppercase_nav", "label": "Uppercase interface labels", "default": true }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "container_width", "label": "Max content width", "min": 1200, "max": 1800, "step": 40, "unit": "px", "default": 1560 },
      { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 16, "step": 1, "unit": "px", "default": 2 },
      { "type": "select", "id": "image_hover", "label": "Product image hover", "options": [
        { "value": "alternate", "label": "Show alternate image" },
        { "value": "zoom", "label": "Subtle zoom" },
        { "value": "none", "label": "None" }
      ], "default": "alternate" },
      { "type": "checkbox", "id": "card_quick_add", "label": "Quick add on product cards", "default": true },
      { "type": "checkbox", "id": "card_show_swatches", "label": "Show colour swatches on hover", "default": true }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      { "type": "paragraph", "content": "All motion is disabled automatically when the visitor's device requests reduced motion." },
      { "type": "checkbox", "id": "motion_reveals", "label": "Scroll reveals", "default": true },
      { "type": "checkbox", "id": "motion_cursor", "label": "Custom cursor (desktop)", "default": true },
      { "type": "checkbox", "id": "motion_transitions", "label": "Page transitions", "default": true },
      { "type": "checkbox", "id": "motion_parallax", "label": "Hero parallax / cursor reactivity", "default": true }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      { "type": "select", "id": "cart_type", "label": "Cart type", "options": [
        { "value": "drawer", "label": "Drawer" },
        { "value": "page", "label": "Page" }
      ], "default": "drawer" },
      { "type": "text", "id": "free_shipping_threshold", "label": "Free shipping threshold", "default": "120", "info": "In your store's main currency, without symbols. Leave blank to hide the progress bar." },
      { "type": "checkbox", "id": "cart_recommendations", "label": "Show \"You may also like\" in the drawer", "default": true },
      { "type": "checkbox", "id": "cart_notes", "label": "Enable order note", "default": false }
    ]
  },
  {
    "name": "Wishlist",
    "settings": [
      { "type": "checkbox", "id": "wishlist_enabled", "label": "Enable wishlist", "default": true, "info": "Stored in the visitor's browser. No app required." }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" },
      { "type": "image_picker", "id": "share_image", "label": "Default social share image" }
    ]
  },
  {
    "name": "Localization",
    "settings": [
      { "type": "checkbox", "id": "show_country_selector", "label": "Show country / currency selector", "default": true },
      { "type": "checkbox", "id": "show_language_selector", "label": "Show language selector", "default": true }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Will be scaled to 32 x 32px" }
    ]
  }
]
